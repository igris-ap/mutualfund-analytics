# Option A (Docker): run `docker compose up -d`, then use this URL.
# DATABASE_URL=postgresql+psycopg://mf:mf@localhost:5432/mf_analytics
POSTGRES_USER=mf
POSTGRES_PASSWORD=mf
POSTGRES_DB=mf_analytics

# Option B (no Docker): an embedded Postgres 16 from the pgserver wheel,
# stored in ~/.mf-analytics/pgdata (outside the repo; set EMBEDDED_PG_DIR to
# move it). Used whenever DATABASE_URL is unset.
USE_EMBEDDED_PG=1

# Optional overrides of config/settings.yaml
# RISK_FREE_RATE=0.065
